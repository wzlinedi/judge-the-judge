{
  "name": "judge-the-judge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static tool that tells a judge author whether an LLM-as-judge prompt can be trusted.",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "diff": "^9.0.0",
    "papaparse": "^5.7.1",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/diff": "^7.0.2",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
