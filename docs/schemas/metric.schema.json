{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric.schema.json",
  "title": "Judge the Judge: metric definition",
  "description": "A metric defined as data (metric-and-checks.md, section 1).",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "judge-the-judge-metric"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "limitations": {
      "type": "string"
    },
    "output_format": {
      "type": "string"
    },
    "judge_set": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "judged_text": {
          "type": "string"
        },
        "sample_reply": {
          "type": "string"
        },
        "reply_mapping": {
          "default": {
            "finding_text": {}
          },
          "type": "object",
          "properties": {
            "finding_text": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "error_rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "match": {
                "type": "string",
                "enum": [
                  "all",
                  "any"
                ]
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "comparison": {
                      "type": "string",
                      "enum": [
                        "equals",
                        "not_equals",
                        "greater_than",
                        "less_than",
                        "is_empty",
                        "is_not_empty"
                      ]
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "comparison"
                  ]
                }
              },
              "finding_text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "match",
              "conditions"
            ]
          }
        },
        "error_catalog": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "example": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "clean_base_cases": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "expected_errors": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "name",
              "fields",
              "expected_errors"
            ]
          }
        }
      },
      "required": [
        "prompt"
      ]
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "default": {
            "type": "number"
          },
          "description": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "default"
        ]
      }
    },
    "measures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "numerator": {
            "type": "string"
          },
          "denominator": {
            "type": "string"
          },
          "of": {
            "type": "string"
          },
          "interval": {
            "type": "string"
          },
          "better": {
            "type": "string",
            "enum": [
              "higher",
              "lower"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "operation",
          "better"
        ]
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "id",
    "name",
    "description",
    "limitations",
    "output_format",
    "judge_set",
    "parameters",
    "measures"
  ]
}
