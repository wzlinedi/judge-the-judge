{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checks.schema.json",
  "title": "Judge the Judge: check configuration",
  "description": "The thresholds of the checks (metric-and-checks.md, section 2). `minimum_sample` is read and ignored: the minimum test size is fixed.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "judge-the-judge-checks"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "measure": {
            "type": "string"
          },
          "comparison": {
            "type": "string",
            "enum": [
              "at_least",
              "at_most"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "measure",
          "comparison",
          "value"
        ]
      }
    },
    "minimum_sample": {}
  },
  "required": [
    "format",
    "schema_version",
    "rules"
  ]
}
